<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_widget"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Glyph gates"
        android:textColor="#E6E0E9"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_music"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_widget_chip"
            android:gravity="center"
            android:textColor="#E6E0E9"
            android:textSize="10sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_volume"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_widget_chip"
            android:gravity="center"
            android:textColor="#E6E0E9"
            android:textSize="10sp"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_battery"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_widget_chip"
            android:gravity="center"
            android:textColor="#E6E0E9"
            android:textSize="10sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_ringtone"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_widget_chip"
            android:gravity="center"
            android:textColor="#E6E0E9"
            android:textSize="10sp"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_visualizer"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_widget_chip"
            android:gravity="center"
            android:textColor="#E6E0E9"
            android:textSize="10sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_all_off"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_widget_chip"
            android:gravity="center"
            android:textColor="#FFB4AB"
            android:textSize="10sp"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_lights"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_margin="3dp"
        android:background="@drawable/bg_widget_chip"
        android:gravity="center"
        android:textColor="#D0BCFF"
        android:textSize="10sp"
        android:maxLines="1" />
</LinearLayout>
