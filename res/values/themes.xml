<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Glyph" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#141218</item>
        <item name="android:colorAccent">#D0BCFF</item>
        <item name="android:colorPrimary">#D0BCFF</item>
        <item name="android:colorPrimaryDark">#141218</item>
        <item name="android:colorSecondary">#CCC2DC</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">#E6E0E9</item>
        <item name="android:textColorSecondary">#CAC4D0</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:alertDialogTheme">@style/Theme.Glyph.Dialog</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.Glyph.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorAccent">#D0BCFF</item>
        <item name="android:textColorPrimary">#E6E0E9</item>
        <item name="android:textColorSecondary">#CAC4D0</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">88%</item>
    </style>
</resources>
