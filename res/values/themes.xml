<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Glyph" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/system_neutral1_50</item>
        <item name="android:colorAccent">@android:color/system_accent1_600</item>
        <item name="android:colorPrimary">@android:color/system_accent1_600</item>
        <item name="android:colorPrimaryDark">@android:color/system_neutral1_50</item>
        <item name="android:colorSecondary">@android:color/system_accent2_600</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@android:color/system_neutral1_900</item>
        <item name="android:textColorSecondary">@android:color/system_neutral2_700</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:alertDialogTheme">@style/Theme.Glyph.Dialog</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.Glyph.Dialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorAccent">@android:color/system_accent1_600</item>
        <item name="android:textColorPrimary">@android:color/system_neutral1_900</item>
        <item name="android:textColorSecondary">@android:color/system_neutral2_700</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">88%</item>
    </style>
</resources>
